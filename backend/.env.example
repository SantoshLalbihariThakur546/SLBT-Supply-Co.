# Copy to .env and adjust as needed.

DJANGO_SECRET_KEY=change-me-to-something-random
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave false to use the zero-config SQLite database (fine for local dev/demo).
# Set true + fill in the POSTGRES_* vars for real select_for_update(nowait) locking.
DJANGO_USE_POSTGRES=false
POSTGRES_DB=ecommerce
POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
